rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'Admin';
    }

    function isSecurityAnalyst() {
      return isAuthenticated() && (getUserRole() == 'Security Analyst' || getUserRole() == 'Admin');
    }

    // 1. Users collection
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // Users can update only display_name and phone_number; role and status are immutable by clients
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'security_hold'])
                    || isAdmin();
      // Only backend server or Admin can create/delete user records
      allow create, delete: if isAdmin();
    }

    // 2. Login Events collection
    match /login_events/{eventId} {
      allow read: if isSecurityAnalyst() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow write: if false; // Only written via authorized backend API
    }

    // 3. Behaviour Logs collection
    match /behaviour_logs/{logId} {
      allow read: if isSecurityAnalyst();
      allow write: if false; // Only written via authorized backend API
    }

    // 4. Threats collection
    match /threats/{threatId} {
      allow read: if isSecurityAnalyst();
      allow write: if false; // Only written via authorized backend API
    }

    // 5. Alerts collection
    match /alerts/{alertId} {
      allow read: if isSecurityAnalyst() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow update: if isSecurityAnalyst();
      allow create, delete: if false; // Only generated via authorized backend engine
    }

    // 6. Audit Logs collection (Immutable security append-only log)
    match /audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only from trusted backend
    }

    // 7. Security Settings collection
    match /security_settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
